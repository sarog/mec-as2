<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">

    <id>distribution</id>

    <formats>
        <format>zip</format>
        <format>tar.gz</format>
    </formats>

    <includeBaseDirectory>true</includeBaseDirectory>

    <files>
        <!-- Main application jar -->
        <file>
            <source>${project.build.directory}/${project.build.finalName}.jar</source>
            <outputDirectory>/</outputDirectory>
        </file>

        <!-- Jetty web applications -->
        <file>
            <source>${project.build.directory}/as2.war</source>
            <outputDirectory>/jetty10/webapps</outputDirectory>
            <!--<outputDirectory>/webapps</outputDirectory>-->
        </file>

        <!--<file>
            <source>${project.build.directory}/webas2.war</source>
            <outputDirectory>/webapps</outputDirectory>
        </file>-->

        <!-- Documentation/license -->
        <file>
            <source>${project.basedir}/README.md</source>
            <outputDirectory>/</outputDirectory>
            <filtered>false</filtered>
        </file>

        <file>
            <source>${project.basedir}/LICENSE.md</source>
            <outputDirectory>/</outputDirectory>
            <filtered>false</filtered>
        </file>
    </files>

    <fileSets>
        <!-- Runtime dependencies copied by maven-dependency-plugin -->
        <!-- This copies every dep into jlib. Comment this out if to place them in sub-dirs instead. -->
        <fileSet>
            <directory>${project.build.directory}/jlib</directory>
            <outputDirectory>/jlib</outputDirectory>
            <includes>
                <include>*.jar</include>
            </includes>
        </fileSet>

        <!-- Embedded Jetty distribution with as2.war in webapps/ -->
        <!--<fileSet>
            <directory>${project.build.directory}/jetty-distribution</directory>
            <outputDirectory>/jetty10</outputDirectory>
            <useDefaultExcludes>true</useDefaultExcludes>
        </fileSet>-->

        <fileSet>
            <directory>${jetty.distribution.dir}/jetty-home-${jetty.version}</directory>
            <outputDirectory>/jetty10</outputDirectory>
            <includes>
                <!--<include>bin/*</include>-->
                <!--<include>etc/*</include>-->
                <include>etc/jetty.xml</include>
                <include>etc/webdefault.xml</include>

                <!--<include>lib/*</include>-->
                <include>lib/jetty-annotations-*.jar</include>
                <include>lib/jetty-cdi-*.jar</include>
                <include>lib/jetty-client-*.jar</include>
                <include>lib/jetty-deploy-*.jar</include>
                <include>lib/jetty-http-*.jar</include>
                <include>lib/jetty-io-*.jar</include>
                <include>lib/jetty-jaas-*.jar</include>
                <include>lib/jetty-jmx-*.jar</include>
                <include>lib/jetty-jndi-*.jar</include>
                <include>lib/jetty-keystore-*.jar</include>
                <include>lib/jetty-memcached-sessions-*.jar</include>
                <include>lib/jetty-proxy-*.jar</include>
                <include>lib/jetty-rewrite-*.jar</include>
                <include>lib/jetty-security-*.jar</include>
                <include>lib/jetty-server-*.jar</include>
                <include>lib/jetty-servlet-*.jar</include>
                <include>lib/jetty-servlet-api-*.jar</include>
                <include>lib/jetty-servlets-*.jar</include>
                <include>lib/jetty-util-*.jar</include>
                <include>lib/jetty-util-ajax-*.jar</include>
                <include>lib/jetty-webapp-*.jar</include>
                <include>lib/jetty-xml-*.jar</include>

                <include>LICENSE.txt</include>
                <include>NOTICE.txt</include>
                <include>README.adoc</include>
                <include>start.jar</include>
                <include>VERSION.txt</include>
                <!--<include>modules/*</include>-->
                <!--<include>start.d/*</include>-->
            </includes>
        </fileSet>

        <fileSet>
            <directory>dist</directory>
            <outputDirectory>/jetty10</outputDirectory>
            <includes>
                <include>jetty.config</include>
            </includes>
        </fileSet>


        <!-- Include local system-scope help jars manually because Maven does not copy system dependencies normally -->
        <fileSet>
            <directory>${project.basedir}/lib/help</directory>
            <outputDirectory>/jlib/help</outputDirectory>
            <includes>
                <include>*.jar</include>
            </includes>
            <useDefaultExcludes>true</useDefaultExcludes>
        </fileSet>

        <!-- SQL scripts: this is copied into as2.jar -->
        <!--<fileSet>
            <directory>${project.basedir}/src/main/java/sqlscript</directory>
            <outputDirectory>/sqlscript</outputDirectory>
            <useDefaultExcludes>true</useDefaultExcludes>
        </fileSet>-->

        <!-- Optional runtime/config resources if needed by deployment -->
        <fileSet>
            <directory>${project.basedir}/src/main/resources/notificationtemplates</directory>
            <outputDirectory>/notificationtemplates</outputDirectory>
            <useDefaultExcludes>true</useDefaultExcludes>
        </fileSet>

    </fileSets>

